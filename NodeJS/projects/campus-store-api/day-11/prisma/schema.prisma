generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  title       String
  price       Float
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
